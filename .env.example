# Application Environment (development, staging, production)
ENVIRONMENT=development
LOG_LEVEL=INFO

# Paths
DATA_DIR=data
RAW_DATA_PATH=data/raw
PROCESSED_DATA_PATH=data/staging
WAREHOUSE_DATA_PATH=data/warehouse

# Database Configuration (if using Postgres / MySQL / etc.)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=de_db
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# API Keys / External Credentials
EXTERNAL_API_KEY=your_api_key_here
EXTERNAL_API_URL=https://api.example.com/v1
